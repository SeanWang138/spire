# SpireFi relayer - copy to .env (never commit .env)
NEAR_RPC_URL=https://test.rpc.fastnear.com
CONTRACT_ID=spire.testnet
KEEPER_ACCOUNT_ID=keeper.spire.testnet
KEEPER_PRIVATE_KEY=ed25519:...

# NEAR AI Cloud (TEE) - live signing is used unless MOCK_TEE=true
NEAR_AI_BASE_URL=https://api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash

# Pinned TEE Ed25519 public key, 32-byte hex (64 hex chars), and canonical
# Ed25519 private key used to sign "spire/..." bytes for apply_ai_proposal
# (ed25519:<base58>, 64-byte hex, or 32-byte hex seed).
TEE_PUBLIC_KEY=
TEE_SIGNING_PRIVATE_KEY=

# true = local deterministic mock signer (tests only, never on a live cycle).
# Requires a private random seed below; there is NO built-in seed.
MOCK_TEE=false
MOCK_TEE_SEED=

# "near-ai" (calls NEAR AI Cloud + signs proposals) |
# "epoch-only" (pure testnet mode without NEAR_AI_API_KEY: runs update_meta() & indexer cleanly)
KEEPER_AI_MODE=epoch-only

# Browser CORS / guest handle suffix overrides for optional Indexer (:8080)
INDEXER_CORS_ORIGIN=*
ACCOUNT_SUFFIX=.spire.testnet

# true = POST /api/accounts really creates *.spire.testnet subaccounts funded by
# KEEPER_ACCOUNT_ID (requires KEEPER_PRIVATE_KEY). false = queue-only (recommended: let Next.js /api/accounts handle faucet).
AUTO_CREATE_ACCOUNTS=false
SUBACCOUNT_FUNDING_YOCTO=600000000000000000000000

POLL_INTERVAL_MS=5000
STREAMER_PORT=8080
